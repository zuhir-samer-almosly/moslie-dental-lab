public-hoist-pattern[]=@inertiajs/core

# Be resilient to flaky registry connections (ECONNRESET) in CI: retry
# failed fetches with a longer backoff instead of failing the whole install.
fetch-retries=5
fetch-retry-factor=10
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
