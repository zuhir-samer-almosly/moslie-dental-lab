{
	# Let's Encrypt contact address. Set ACME_EMAIL in the production env;
	# the default is a placeholder that only keeps this config valid.
	email {$ACME_EMAIL:admin@example.com}
}

# Production configuration with automatic HTTPS
dental-lab.zoher-moslie.me {
	reverse_proxy app:80

	encode gzip zstd

	# Automatic HTTPS with Let's Encrypt
	tls {
		protocols tls1.2 tls1.3
	}

	# Security headers.
	#
	# Content-Security-Policy and Permissions-Policy are NOT set here: the CSP
	# carries a per-response nonce, so it has to come from the app (see
	# App\Http\Middleware\ContentSecurityPolicy).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		# PHP advertises its exact patch level here, which hands a scanner the
		# list of CVEs to try. The app strips it too; this is the backstop for
		# responses that never reach that middleware (static files, errors).
		-X-Powered-By
		# X-XSS-Protection is deliberately gone. The legacy auditor it enabled
		# was removed from Chrome and Edge years ago, and on the browsers that
		# still honour it the filter has itself been a source of information
		# leaks. CSP above is the real control.
	}

	# Logging
	log {
		output stdout
		format console
		level INFO
	}
}

# Host-local site blocks live in conf.d/ and are NOT tracked in git — see
# docker/caddy/conf.d/README.md. An empty glob is a warning, not an error, so a
# fresh clone with no extra sites still loads.
import /etc/caddy/conf.d/*.caddy
